# Dedicated PostgreSQL database used ONLY by automated tests.
#
# IMPORTANT:
# - Do not point this at your normal KiteDesk development database.
# - Do not point this at Render production.
# - The database name must contain the word "test".
#
# Example:
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kitedesk_test?schema=public

TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kitedesk_test?schema=public
